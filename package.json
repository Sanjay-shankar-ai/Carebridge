{
  "name": "carebridge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CareBridge — Autonomous AI-First Healthcare Care-Coordination Platform",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend run start",
    "dev:backend": "python -m uvicorn app.main:app --reload --app-dir backend",
    "test:backend": "pytest backend/tests",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down"
  },
  "keywords": [
    "healthcare",
    "agentic-ai",
    "care-coordination",
    "langgraph",
    "fastapi",
    "nextjs",
    "fhir"
  ],
  "author": "Ai_Mavericks",
  "license": "UNLICENSED"
}
