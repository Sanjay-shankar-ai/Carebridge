# ==============================================================================
# CareBridge Environment Variables Template
# ==============================================================================

# Backend Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME="CareBridge AI Care Coordinator"
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-key
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Supabase Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/carebridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carebridge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LangGraph PostgreSQL Checkpointer Connection
CHECKPOINTER_DB_URI=postgresql://postgres:postgres@localhost:5432/carebridge

# Primary LLM: GroqCloud
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI API Configuration (Secondary)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Care Coordination & SLA Defaults (in hours)
DEFAULT_ACK_SLA_HOURS=24
DEFAULT_REFERRAL_SLA_HOURS=48
DEFAULT_APPOINTMENT_SLA_DAYS=14
DEFAULT_CLOSURE_SLA_DAYS=60

# Demo User Credentials (read by scripts/reset_demo_users.py)
DEMO_DOCTOR_PASSWORD=DoctorPass123!
DEMO_COORDINATOR_PASSWORD=CoordinatorPass123!
DEMO_PATIENT_PASSWORD=PatientPass123!

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="CareBridge"
